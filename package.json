{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"try{require('fs').rmSync('.next/dev/lock',{force:true})}catch{}\"",
    "dev": "npx tsx watch server.ts",
    "dev:next": "next dev -p 3000",
    "dev:fast": "yarn dev:next",
    "build": "next build",
    "start": "NODE_ENV=production npx tsx server.ts",
    "start:next": "next start",
    "test": "jest --passWithNoTests --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint",
    "setup": "node scripts/setup-emulatorjs.js",
    "scan:library": "node scripts/scan-library.js",
    "seed:library": "node scripts/seed-library-from-r2.js",
    "upload:roms": "node scripts/upload-to-r2.js",
    "upload:manifest": "node scripts/upload-manifest.js",
    "verify:r2": "node scripts/verify-r2-flow.js --local",
    "migrate:profiles": "node scripts/migrate-profiles-to-postgres.js",
    "migrate:saves": "node scripts/migrate-saves-to-r2.js",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "next": "16.1.6",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.5.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
