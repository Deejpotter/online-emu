# ======================================
# Online Emulator - Environment Variables
# ======================================
# Copy this file to .env.local and fill in the values

# ======================================
# Server Configuration
# ======================================

# Games directory path
# Development: ./public/roms (inside project)
# Production: /root/online-emu/roms (outside public folder)
GAMES_DIR=./public/roms

# Port to run the server on (default: 3100)
PORT=3100

# Data directory for profiles and metadata (default: ./data)
DATA_DIR=./data

# ======================================
# Cloudflare R2 (ROM + library storage)
# ======================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deejpotter

# Library source: "r2" (Coolify) or "local" (dev with disk ROMs)
LIBRARY_SOURCE=local
